+static bool mvkDTRBoolEnvValue(const char* name, bool defaultValue) {
+	const char* env = getenv(name);
+	if ( !env ) { return defaultValue; }
+	while (*env == ' ' || *env == '\t' || *env == '\n' || *env == '\r') { env++; }
+	if (*env == '0') { return false; }
+	if (*env == '1') { return true; }
+	return defaultValue;
+}
