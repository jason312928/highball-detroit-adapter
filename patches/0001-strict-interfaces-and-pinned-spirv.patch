+// Only invoked after a vertex-stage failure. Log the app's data without guessing a mapping.
+static void mvkDTRLogVertexInterface(MVKBaseObject* object, const VkGraphicsPipelineCreateInfo* info,
+                                   const VkPipelineShaderStageCreateInfo* stage) {
+    object->reportMessage(MVK_CONFIG_LOG_LEVEL_ERROR, "HB_DETROIT_STRICT_INTERFACE_V1: pipeline=%p entry=%s", info,
+                stage && stage->pName ? stage->pName : "<null>");
+    const auto* vi = info ? info->pVertexInputState : nullptr;
+    if (vi) {
+        object->reportMessage(MVK_CONFIG_LOG_LEVEL_ERROR, "HB_DETROIT_STRICT_INTERFACE_V1: bindings=%u attributes=%u",
+                    vi->vertexBindingDescriptionCount, vi->vertexAttributeDescriptionCount);
+        for (uint32_t i = 0; i < vi->vertexBindingDescriptionCount; ++i) {
+            const auto& b = vi->pVertexBindingDescriptions[i];
+            object->reportMessage(MVK_CONFIG_LOG_LEVEL_ERROR, "HB_DETROIT_STRICT_INTERFACE_V1: binding=%u stride=%u rate=%u",
+                        b.binding, b.stride, b.inputRate);
+        }
+        for (uint32_t i = 0; i < vi->vertexAttributeDescriptionCount; ++i) {
+            const auto& a = vi->pVertexAttributeDescriptions[i];
+            object->reportMessage(MVK_CONFIG_LOG_LEVEL_ERROR, "HB_DETROIT_STRICT_INTERFACE_V1: location=%u binding=%u format=%u offset=%u",
+                        a.location, a.binding, a.format, a.offset);
+        }
+        for (const auto* next = static_cast<const VkBaseInStructure*>(vi->pNext); next; next = next->pNext) {
+            object->reportMessage(MVK_CONFIG_LOG_LEVEL_ERROR, "HB_DETROIT_STRICT_INTERFACE_V1: vertex-input pNext sType=%u", next->sType);
+        }
+    }
+    const auto* si = stage ? stage->pSpecializationInfo : nullptr;
+    if (si) {
+        const char* hex = "0123456789abcdef";
+        for (uint32_t i = 0; i < si->mapEntryCount; ++i) {
+            const auto& e = si->pMapEntries[i];
+            std::string value;
+            if (si->pData && e.offset <= si->dataSize && e.size <= si->dataSize - e.offset) {
+                const auto* data = static_cast<const unsigned char*>(si->pData) + e.offset;
+                for (size_t j = 0; j < e.size; ++j) {
+                    value += hex[data[j] >> 4]; value += hex[data[j] & 15];
+                }
+            } else { value = "<invalid range>"; }
+            object->reportMessage(MVK_CONFIG_LOG_LEVEL_ERROR, "HB_DETROIT_STRICT_INTERFACE_V1: specialization id=%u offset=%u size=%zu bytes=%s",
+                        e.constantID, e.offset, e.size, value.c_str());
+        }
+    }
+}
