@@ -0,0 +1,9 @@
+#pragma once
+#import <Metal/Metal.h>
+#import <MetalFX/MetalFX.h>
+
+// Private Detroit opt-in. No Vulkan feature or vertex-interface changes.
+bool mvkDTRMetalFXEnabled(id<MTLDevice> device);
+double mvkDTRMetalFXScale();
+CGSize mvkDTRMetalFXRenderSize(CGSize displaySize, id<MTLDevice> device);
+extern "C" const char* hb_detroit_metalfx_default_marker();
diff --git a/MoltenVK/MoltenVK/GPUObjects/MVKDetroitMetalFX.mm b/MoltenVK/MoltenVK/GPUObjects/MVKDetroitMetalFX.mm
new file mode 100644
index 00000000..dcb94756
--- /dev/null
+++ b/MoltenVK/MoltenVK/GPUObjects/MVKDetroitMetalFX.mm
@@ -0,0 +1,58 @@
+#include "MVKDetroitMetalFX.h"
+#include <cmath>
+#include <cstdlib>
+#include <cstring>
+
+#ifndef MVK_DTR_METALFX_DEFAULT
+#define MVK_DTR_METALFX_DEFAULT 0
+#endif
+
+extern "C" __attribute__((visibility("default"))) const char* hb_detroit_metalfx_default_marker() {
+#if MVK_DTR_METALFX_DEFAULT
+    return "HB_DETROIT_METALFX_DEFAULT_ON_V1";
+#else
+    return "HB_DETROIT_METALFX_DEFAULT_OFF_V1";
+#endif
+}
+
+extern "C" __attribute__((visibility("default"))) uint32_t hb_detroit_metalfx_surface_scaling_enabled() {
+    return mvkDTRMetalFXEnabled(nil) ? 1 : 0;
+}
+
+double mvkDTRMetalFXScale() {
+    static double value = [] {
+        const char* text = getenv("MVK_DTR_METALFX_SCALE");
+        if (!text || !*text) { return 0.75; }
+        char* end = nullptr;
+        double scale = strtod(text, &end);
+        return end && !*end && std::isfinite(scale) && scale >= 0.5 && scale < 1.0 ? scale : 0.75;
+    }();
+    return value;
+}
+
+bool mvkDTRMetalFXEnabled(id<MTLDevice> device) {
+    static bool requested = [] {
+        const char* text = getenv("MVK_DTR_METALFX_SPATIAL");
+        if (!text || !*text) { return bool(MVK_DTR_METALFX_DEFAULT); }
+        return !strcmp(text, "1") || !strcasecmp(text, "true");
+    }();
+    if (!requested) { return false; }
+    if (@available(macOS 13.0, *)) {
+        if (!device) {
+            static id<MTLDevice> defaultDevice = MTLCreateSystemDefaultDevice();
+            device = defaultDevice;
+        }
+        return device && [MTLFXSpatialScalerDescriptor supportsDevice:device];
+    }
+    return false;
+}
+
+CGSize mvkDTRMetalFXRenderSize(CGSize size, id<MTLDevice> device) {
+    // Detroit's fixed bootstrap requests 1024x576 without adopting a scaled extent.
+    // Keep small bootstrap surfaces native, including their advertised capabilities.
+    if (!mvkDTRMetalFXEnabled(device) || size.width < 4 || size.height < 4 ||
+        (size.width <= 1024 && size.height <= 576)) { return size; }
+    double scale = mvkDTRMetalFXScale();
+    return CGSizeMake(fmax(2.0, floor(size.width * scale / 2.0) * 2.0),
+                      fmax(2.0, floor(size.height * scale / 2.0) * 2.0));
+}
