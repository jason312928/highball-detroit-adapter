+}
+
+VkResult MVKSwapchain::encodeMetalFX(id<MTLTexture> input, id<MTLTexture> output,
+                                    id<MTLTexture> drawable, id<MTLCommandBuffer> commandBuffer) {
+    std::lock_guard<std::mutex> lock(_metalFXLock);
+    if (!input || !output || !drawable || input.width != _imageExtent.width || input.height != _imageExtent.height ||
+        output.width != _metalFXOutputExtent.width || output.height != _metalFXOutputExtent.height ||
+        drawable.width != output.width || drawable.height != output.height ||
+        input.pixelFormat != drawable.pixelFormat || output.pixelFormat != drawable.pixelFormat) {
+        return reportError(VK_ERROR_OUT_OF_DATE_KHR, "Detroit MetalFX: resized or incompatible presentation textures; recreate swapchain");
+    }
+    id<MTLFXSpatialScaler> scaler = (id<MTLFXSpatialScaler>)_metalFXScaler;
+    scaler.colorTexture = input; scaler.outputTexture = output;
+    scaler.inputContentWidth = input.width; scaler.inputContentHeight = input.height;
+    [scaler encodeToCommandBuffer:commandBuffer];
+    id<MTLBlitCommandEncoder> blit = [commandBuffer blitCommandEncoder];
+    [blit copyFromTexture:output sourceSlice:0 sourceLevel:0 sourceOrigin:MTLOriginMake(0,0,0)
+               sourceSize:MTLSizeMake(output.width,output.height,1) toTexture:drawable destinationSlice:0
+         destinationLevel:0 destinationOrigin:MTLOriginMake(0,0,0)];
+    [blit endEncoding];
+    scaler.colorTexture = nil; scaler.outputTexture = nil;
+    if (++_metalFXFrames <= 3) {
+        fprintf(stderr, "[detroit-metalfx] encoded frame=%llu input=%zux%zu output=%zux%zu\n",
+                (unsigned long long)_metalFXFrames, (size_t)input.width, (size_t)input.height,
+                (size_t)output.width, (size_t)output.height);
+    }
+    return VK_SUCCESS;
+}
