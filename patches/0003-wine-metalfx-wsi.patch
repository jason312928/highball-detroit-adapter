+/* HB_DETROIT_METALFX_WSI_V1: activate only when the loaded private host exposes the real scaler. */
+static BOOL extents_equals(const VkExtent2D *extents, const RECT *rect);
+static unsigned int (*detroit_metalfx_host_enabled)(void);
+static pthread_once_t detroit_metalfx_once = PTHREAD_ONCE_INIT;
+
+static void detroit_metalfx_init(void)
+{
+    detroit_metalfx_host_enabled = dlsym(vulkan_handle, "hb_detroit_metalfx_surface_scaling_enabled");
+}
+
+static BOOL detroit_metalfx_enabled(void)
+{
+    pthread_once(&detroit_metalfx_once, detroit_metalfx_init);
+    return detroit_metalfx_host_enabled && detroit_metalfx_host_enabled();
+}
+
+static BOOL detroit_extents_match(struct vulkan_physical_device *physical_device,
+                                  struct surface *surface, const VkExtent2D *extent, const RECT *rect)
+{
+    VkSurfaceCapabilitiesKHR caps;
+    struct vulkan_instance *instance = physical_device->instance;
+    if (extents_equals(extent, rect)) return TRUE; /* Fixed-size startup/passthrough. */
+    if (!detroit_metalfx_enabled()) return FALSE;
+    if (instance->p_vkGetPhysicalDeviceSurfaceCapabilitiesKHR(physical_device->host.physical_device,
+            surface->obj.host.surface, &caps) != VK_SUCCESS) return FALSE;
+    return caps.currentExtent.width == extent->width && caps.currentExtent.height == extent->height;
+}
