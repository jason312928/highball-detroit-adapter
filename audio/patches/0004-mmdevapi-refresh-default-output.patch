+/* Opt-in for the private Detroit engine. Query the backend instead of the startup snapshot.
+ * Never replace an MMDevice which may be held by a live IAudioClient. */
+static HRESULT detroit_default_render_device(IMMDevice **result)
+{
+    struct get_endpoint_ids_params params = {0};
+    MMDevice *dev, *found = NULL;
+    const char *device_name;
+    const WCHAR *name;
+    GUID guid;
+    HRESULT hr;
+
+    TRACE("HB_DETROIT_AUDIO_V2: refreshing default render endpoint\n");
+    params.flow = eRender;
+    params.size = 1024;
+    EnterCriticalSection(&detroit_device_lock);
+    do
+    {
+        free(params.endpoints);
+        params.endpoints = NULL;
+        if (params.size > 16 * 1024 * 1024 || !(params.endpoints = malloc(params.size)))
+        {
+            params.result = E_OUTOFMEMORY;
+            break;
+        }
+        params.result = E_FAIL;
+        __wine_unix_call(drvs.module_unixlib, get_endpoint_ids, &params);
+    } while (params.result == HRESULT_FROM_WIN32(ERROR_INSUFFICIENT_BUFFER));
+    hr = params.result;
+    if (SUCCEEDED(hr) && (!params.num || params.default_idx >= params.num)) hr = E_NOTFOUND;
+    if (SUCCEEDED(hr))
+    {
+        name = (const WCHAR *)((const char *)params.endpoints + params.endpoints[params.default_idx].name);
+        device_name = (const char *)params.endpoints + params.endpoints[params.default_idx].device;
+        get_device_guid(eRender, device_name, &guid);
+        LIST_FOR_EACH_ENTRY(dev, &device_list, MMDevice, entry)
+            if (dev->flow == eRender && IsEqualGUID(&dev->devguid, &guid)) { found = dev; break; }
+        if (!found)
+        {
+            found = MMDevice_Create(name, &guid, eRender, DEVICE_STATE_ACTIVE, FALSE);
+            if (found) set_format(found);
+        }
+        if (!found) hr = E_OUTOFMEMORY;
+        else
+        {
+            *result = &found->IMMDevice_iface;
+            IMMDevice_AddRef(*result);
+        }
+    }
+    free(params.endpoints);
+    LeaveCriticalSection(&detroit_device_lock);
+    return hr;
+}
