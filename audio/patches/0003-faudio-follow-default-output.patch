+/* Detroit routing: keep the voice graph and mix format while replacing only WASAPI. */
+static HRESULT FAudio_CreateAudioClient(
+	IMMDevice *device, WAVEFORMATEXTENSIBLE *format, HANDLE event,
+	REFERENCE_TIME duration, IAudioClient **client)
+{
+	HRESULT hr;
+	*client = NULL;
+	hr = IMMDevice_Activate(device, &IID_IAudioClient, CLSCTX_ALL, NULL, (void **)client);
+	if (FAILED(hr)) return hr;
+	hr = IAudioClient_Initialize(*client, AUDCLNT_SHAREMODE_SHARED,
+		AUDCLNT_STREAMFLAGS_EVENTCALLBACK | AUDCLNT_STREAMFLAGS_AUTOCONVERTPCM,
+		duration * 3, 0, &format->Format, &GUID_NULL);
+	if (SUCCEEDED(hr)) hr = IAudioClient_SetEventHandle(*client, event);
+	if (FAILED(hr)) { IAudioClient_Release(*client); *client = NULL; }
+	return hr;
+}
+
+static HRESULT FAudio_StartAudioClient(struct FAudioAudioClientThreadArgs *args,
+	IAudioClient *client, IAudioRenderClient **render, UINT *frames)
+{
+	HRESULT hr;
+	BYTE *silence;
+	*render = NULL;
+	hr = IAudioClient_GetService(client, &IID_IAudioRenderClient, (void **)render);
+	if (SUCCEEDED(hr)) hr = IAudioClient_GetBufferSize(client, frames);
+	if (SUCCEEDED(hr) && *frames < args->updateSize) hr = AUDCLNT_E_BUFFER_SIZE_ERROR;
+	/* Do not consume queued source audio before the replacement has started. */
+	if (SUCCEEDED(hr)) hr = IAudioRenderClient_GetBuffer(*render, *frames, &silence);
+	if (SUCCEEDED(hr)) hr = IAudioRenderClient_ReleaseBuffer(*render, *frames, AUDCLNT_BUFFERFLAGS_SILENT);
+	if (SUCCEEDED(hr)) hr = IAudioClient_Start(client);
+	if (FAILED(hr) && *render) { IAudioRenderClient_Release(*render); *render = NULL; }
+	return hr;
+}
+
+static void FAudio_CloseAudioClient(struct FAudioAudioClientThreadArgs *args,
+	IAudioRenderClient **render)
+{
+	if (args->client)
+	{
+		/* Removal may make Stop fail; cleanup must still finish. */
+		IAudioClient_Stop(args->client);
+		if (*render) IAudioRenderClient_Release(*render);
+		IAudioClient_Release(args->client);
+	}
+	*render = NULL;
+	args->client = NULL;
+	args->platform->client = NULL;
+}
